# Set these in the shell or IIS host environment. The app doesn't load .env files.
ASPNETCORE_ENVIRONMENT=Production
ConnectionStrings__Koral=Server=DATABASE_HOST;Database=DATABASE_NAME;User ID=DATABASE_USER;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=False
Hosting__PublicUrl=https://YOUR_DOMAIN
Hosting__DisableHttpsRedirect=false
Bootstrap__Email=owner@example.com
Bootstrap__Password=REPLACE_WITH_A_GENERATED_TEMPORARY_PASSWORD
Database__MigrateOnStartup=false
Media__Root=App_Data/media
Media__MaxUploadBytes=25000000
Security__KeyPath=App_Data/keys
